# Gradle / build output
/build/
/.gradle/
/repo/

# Dev run directories
/run/
/runs/
/server/

# Portable JDK, if one is ever dropped here (MobHealth-Forge's is used by default).
# Anything else under tools/ is source and must stay tracked - WoodDye lost a generator
# script to a blanket /tools/ ignore once already.
/tools/*
!/tools/*.py
!/tools/*.sh

# Legacy Eclipse project for the 1.8 Bukkit plugin (kept as reference, see CLAUDE.md)
/bin/

# Python venv, for the odd image-processing script (no Pillow system-wide, PEP 668 blocks pip)
/venv/

# IDE
/.idea/
*.iml
/.vscode/
# Eclipse. The 2013 Bukkit plugin's .classpath/.project/.settings lived here until 3.0.0 - they
# pinned JavaSE-1.6, Spigot 1.8 and absolute C:/Users paths, and pointed at the src/ and bin/ of
# the removed 1.8 tree. ModDevGradle can regenerate them with `./gradlew eclipse` if wanted.
/.classpath
/.project
/.settings/

# Claude Code local settings
/.claude/settings.local.json
